# Regular Solution - Apache / LiteSpeed rules for the live site (DirectAdmin).
# Safe on XAMPP too: the HTTPS redirect skips localhost.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always use HTTPS on the live domain (needs the SSL certificate enabled first).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # The old Google Ads landing page now lives on the home page.
    RewriteRule ^packers-movers-chennai(\.html)?$ / [L,R=301]
</IfModule>

# Never serve data, logs, notes or the admin's internal include files.
<FilesMatch "\.(sqlite|sqlite3|db|log|csv|md|bak|sql|ini|toml)$">
    Require all denied
</FilesMatch>
<FilesMatch "^_[a-z]+\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Let browsers cache images, fonts, CSS and JS (pages themselves stay fresh).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
